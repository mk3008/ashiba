{
  "name": "@ashiba-ts/driver-adapter-pg",
  "version": "0.1.1",
  "description": "Optional Ashiba compatibility adapter for pg clients.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mk3008/ashiba"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @ashiba-ts/driver-adapter-core build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.contract-tests.json",
    "test": "vitest run",
    "test:live": "vitest run tests/postgres-live.smoke.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ashiba-ts/driver-adapter-core": "workspace:*"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "fast-check": "^4.8.0",
    "pg": "^8.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
