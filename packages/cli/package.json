{
  "name": "@ashiba-ts/cli",
  "version": "0.3.0",
  "description": "SQL-first SQL tooling and verification CLI for TypeScript applications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mk3008/ashiba"
  },
  "type": "module",
  "bin": {
    "ashiba": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @ashiba-ts/named-parameters build && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run tests/sql-resource.live.test.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ashiba-ts/named-parameters": "workspace:*",
    "commander": "^12.0.0",
    "diff": "^8.0.2",
    "pg": "^8.21.0",
    "rawsql-ts": "^0.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
