{
  "name": "@ashiba-ts/driver-adapter-mssql",
  "version": "0.0.1",
  "description": "Optional Ashiba compatibility adapter for mssql clients.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mk3008/ashiba"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @ashiba-ts/driver-adapter-core build && pnpm --filter @ashiba-ts/named-parameters build && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ashiba-ts/driver-adapter-core": "workspace:*",
    "@ashiba-ts/named-parameters": "workspace:*"
  },
  "peerDependencies": {
    "mssql": ">=11"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/mssql": "^9.1.8",
    "mssql": "^11.0.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
