{
  "name": "ashiba-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "pnpm -r run --if-present build",
    "typecheck": "pnpm --filter @ashiba-ts/named-parameters build && pnpm -r --filter \"!@ashiba-ts/named-parameters\" run --if-present typecheck",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "test": "pnpm -r run --if-present test",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm verify:publish-order && pnpm docs:build && pnpm verify:benchmark-index && pnpm verify:consumer-install && pnpm verify:customer-tutorial && pnpm verify:customer-functional",
    "verify:benchmark-index": "node scripts/verify-benchmark-index.mjs",
    "verify:consumer-install": "node scripts/verify-consumer-install.mjs",
    "verify:npm-distribution": "node scripts/verify-npm-distribution.mjs",
    "verify:publish-order": "node scripts/verify-publish-order.mjs",
    "verify:customer-tutorial": "node scripts/verify-customer-tutorial.mjs",
    "verify:customer-functional": "node scripts/verify-customer-functional.mjs",
    "verify:customer-functional:docker": "node scripts/verify-customer-functional.mjs",
    "changeset": "changeset",
    "changesets:version": "changeset version",
    "changesets:version-lockfile": "changeset version && pnpm install --lockfile-only",
    "changesets:publish": "node scripts/publish-in-dependency-order.mjs",
    "changesets:status": "changeset status",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.13.10",
    "@vue/server-renderer": "^3.5.34",
    "husky": "^9.1.7",
    "typescript": "^5.8.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.34",
    "vitest": "^4.1.11"
  }
}
