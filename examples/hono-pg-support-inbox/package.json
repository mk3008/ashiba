{
  "name": "ashiba-hono-pg-support-inbox-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "pnpm --filter @ashiba-ts/driver-adapter-core build && pnpm --filter @ashiba-ts/driver-adapter-pg build && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm check:sql && pnpm test",
    "check:sql": "node node_modules/@ashiba-ts/cli/dist/index.js project check --root-dir .",
    "db:up": "docker compose up -d",
    "db:wait": "tsx scripts/wait-for-db.ts",
    "db:down": "docker compose down --volumes",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@ashiba-ts/driver-adapter-core": "workspace:*",
    "@ashiba-ts/driver-adapter-pg": "workspace:*",
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.34",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@ashiba-ts/cli": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "dotenv": "^16.6.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
