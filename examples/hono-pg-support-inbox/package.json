{
  "name": "ashiba-hono-pg-support-inbox-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "pnpm --filter @ashiba-ts/driver-adapter-pg build && pnpm --filter @ashiba-ts/testkit-adapter-pg build && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:mapper": "vitest run src/features -t ZTD",
    "ashiba:generate": "node node_modules/@ashiba-ts/cli/dist/index.js feature query refresh support-inbox list-tickets && node node_modules/@ashiba-ts/cli/dist/index.js feature query refresh support-inbox get-ticket-detail",
    "check:drift": "node node_modules/@ashiba-ts/cli/dist/index.js check",
    "ashiba:verify": "node node_modules/@ashiba-ts/cli/dist/index.js check --full --mapper-test-command \"vitest run\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down --volumes",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@ashiba-ts/driver-adapter-pg": "file:../../packages/driver-adapter-pg",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@ashiba-ts/cli": "file:../../packages/cli",
    "@ashiba-ts/testkit-adapter-pg": "file:../../packages/testkit-adapter-pg",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "dotenv": "^16.6.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
