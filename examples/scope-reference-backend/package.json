{
  "name": "scope-reference-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate:sql-artifacts": "node scripts/generate-sql-artifacts.mjs",
    "check:sql-artifacts": "pnpm --filter @ashiba-ts/cli build && pnpm generate:sql-artifacts && git diff --exit-code -- src/tickets/generated",
    "preverify:postgres-contract": "pnpm --filter @ashiba-ts/cli build",
    "verify:postgres-contract": "node scripts/verify-postgres-contract.mjs",
    "verify": "pnpm typecheck && pnpm check:sql-artifacts && pnpm test && pnpm verify:postgres-contract",
    "db:up": "docker compose up -d"
  },
  "dependencies": {
    "@ashiba-ts/driver-adapter-pg": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@ashiba-ts/cli": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
